# Adresse de l'API NestJS, utilisée par le serveur Next.js (génération des pages)
API_URL=http://localhost:4000

# Adresse de l'API vue depuis le navigateur (filtres des réalisations, formulaire de contact)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Adresse publique du site : URLs canoniques, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Doit être identique à REVALIDATE_SECRET dans apps/api/.env
REVALIDATE_SECRET=change-me-with-another-long-random-string-48
