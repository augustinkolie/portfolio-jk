# Copier ce fichier en .env puis adapter les valeurs.

NODE_ENV=development
PORT=4000

# Correspond au service "db" de docker-compose.yml
DATABASE_URL=postgresql://btp:btp_dev_password@localhost:5432/portfolio_btp

# Connexions simultanées à PostgreSQL. Mettre 1 avec la base locale de « prisma dev ».
DATABASE_POOL_MAX=10

# Origine autorisée par CORS (site Next.js)
WEB_ORIGIN=http://localhost:3000

# Secret de signature des access tokens : 32 caractères minimum.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-with-a-long-random-string-of-48-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Mettre à 1 derrière un reverse proxy (Nginx, Caddy…) pour que la limitation de débit voie la vraie IP.
TRUST_PROXY=0

# Stockage des médias. "local" écrit dans UPLOADS_DIR ; le pilote S3 sera ajouté pour la production.
STORAGE_DRIVER=local
UPLOADS_DIR=uploads
MEDIA_PUBLIC_URL=http://localhost:4000/uploads

# Secret partagé avec le site Next.js (route /api/revalidate) : 32 caractères minimum.
REVALIDATE_SECRET=change-me-with-another-long-random-string-48

# Utilisés uniquement par "npm run seed:admin". Retirer ADMIN_PASSWORD du fichier après usage.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
